# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI_PROVIDER: 'production' to use real Gemini/wav2vec, or 'demo' for resilient fallback mode
AI_PROVIDER="demo"

# SPEECH_MODEL_URL: Optional external speech inference microservice
SPEECH_MODEL_URL=""

# STORAGE_BUCKET: Secure object storage bucket for 24h voice retention
STORAGE_BUCKET="aarogyaspeech-audio-vault"
